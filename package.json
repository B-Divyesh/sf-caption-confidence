{
  "name": "caption-confidence",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:site": "vite --config vite.site.config.ts",
    "build:extension": "wxt build",
    "build:site": "npm run build:extension && vite build --config vite.site.config.ts && node scripts/package-extension.mjs",
    "build": "node scripts/clean.mjs && npm run build:site",
    "test": "vitest run",
    "test:e2e": "xvfb-run -a playwright test",
    "verify:billing": "node scripts/verify-live-checkout.mjs",
    "lint": "eslint .",
    "check": "tsc --noEmit",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.58.2",
    "@types/chrome": "0.0.326",
    "archiver": "7.0.1",
    "eslint": "10.0.1",
    "globals": "16.4.0",
    "typescript": "5.9.2",
    "typescript-eslint": "8.68.0",
    "vite": "7.3.6",
    "vitest": "3.2.7",
    "wxt": "0.21.4"
  }
}
